{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipCheck",
  "identifier": "dev.clipcheck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ClipCheck",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "theme": "Dark",
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob: http://clip.localhost http://127.0.0.1:*; img-src 'self' data: http://clip.localhost http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ClipCheck",
    "shortDescription": "Local-only game recorder for Windows",
    "longDescription": "A lightweight, local-only game recorder: auto-detects games, records the game window, and saves \"past N minutes\" clips on hotkey. Recordings stay in folders you choose.",
    "copyright": "Copyright (C) 2026 ClipCheck contributors. Licensed under Apache-2.0.",
    "category": "Utility",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../licenses/*": "licenses/",
      "../../../LICENSE": "licenses/LICENSE.txt",
      "../../../NOTICE": "licenses/NOTICE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "customLanguageFiles": {
          "English": "../../../installer/English.nsh"
        },
        "compression": "lzma",
        "startMenuFolder": "ClipCheck",
        "installerHooks": "../../../installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBQkMxNzhBQUZGNTlBNkEKUldScW12V3ZpaGU4eWhwRlBnaWp0eDZEMGxnNzc4dFdUcE9GdGVsbXhJRitVb0JrTTJVODFiL2UK",
      "endpoints": [
        "https://github.com/rangamitch/clipcheck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
